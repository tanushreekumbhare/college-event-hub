# ==========================================
# College Event Hub - Environment Variables
# ==========================================

# Port (Google App Engine sets this automatically, default 8080)
PORT=8080

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/college_events?retryWrites=true&w=majority
MONGODB_URI=

# Session Secret Key (use a long, random string in production)
SESSION_SECRET=your_super_secret_session_key_change_me_in_production

# Optional Initial Admin Seeding Configuration
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=change_this_admin_password_123
